# Copia este archivo como backend/.env (CÓPIALO, no lo renombres) y completa los valores.
# backend/.env NO se versiona (está en .gitignore).
# Sin backend/.env todo sigue funcionando con los datos de ejemplo (archivos JSON de cada sección).
# Estas variables también pueden definirse en el sistema (servidor, Docker, etc.): las del sistema tienen prioridad sobre este archivo.
# Si una contraseña lleva # o espacios, ponla entre comillas: DB_PASSWORD="mi clave#1"

# --- Sesión del Portal Empresarial (acceso exclusivo de TI: recurso documentaciontecnica) ---
# PORTAL_API_URL: la misma dirección que VITE_API_URL_NEW del portal, sin "/auth/me" al final. La API le pregunta
# al portal quién es el usuario (cabecera id-session) y si tiene el recurso. Sin poder validar, responde 503 (no deja pasar).
# DOC_AUTH: "portal" exige sesión; "ninguna" no valida (SOLO para desarrollo local).
# Sin definirla: "portal" si hay PORTAL_API_URL o si NODE_ENV=production; si no, "ninguna".
PORTAL_API_URL=
DOC_AUTH=
# Segundos que se recuerda una sesión ya validada (60 por defecto; 0 = preguntar al portal en cada petición)
DOC_SESION_CACHE_S=60

# --- PostgreSQL del almacén de datos (core.dim_item). Usar un usuario de SOLO LECTURA ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- SAP HANA (Diccionario: botón «Actualizar desde SAP»). Usar un usuario de SOLO LECTURA ---
# HANA_SCHEMA es la base de la empresa en SAP Business One (por ejemplo SBO_AUTOLLANTA_PROD).
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=
# Poner true solo si el servidor exige conexión cifrada (TLS)
HANA_ENCRYPT=false

# --- De dónde lee Completitud: "json" (datos de ejemplo, por defecto) o "postgres" (consulta en vivo) ---
COMPLETITUD_FUENTE=json

# Minutos que se conserva el resultado de la consulta antes de volver a leer PostgreSQL (por defecto 10)
COMPLETITUD_CACHE_MIN=10

# --- Servidor independiente (Opción A: servicio aparte como DDMRP) ---
# Puerto donde escucha `npm start` en backend/ (por defecto 3010)
PORT=3010
# Orígenes adicionales permitidos por CORS separados por coma (el mismo host/IP ya está permitido por defecto)
# Ejemplo: CORS_ORIGEN=https://portal.grupovii.com,http://192.168.0.68:5000
CORS_ORIGEN=
